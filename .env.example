# Supabase project URL and public anon key.
# Find them in Supabase Dashboard → Project Settings → API.
# Never expose the service_role key in React or Cloudflare Pages.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Auth email used internally when the login form receives username "admin".
VITE_ADMIN_EMAIL=admin@indianclubec.com

# Local demonstration only. With Supabase unconfigured, `npm run dev` already allows admin/admin.
# Set true only in a private preview environment; never enable it on the public production site.
VITE_ADMIN_DEMO=false

# Existing booking destination. Replace with the definitive AgendaPro URL when confirmed.
VITE_BOOKING_URL=https://indianclubec.com/citas
